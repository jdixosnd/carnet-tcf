{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carnet TCF",
  "version": "1.5.0",
  "identifier": "com.carnet.tcf",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Carnet TCF",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self' blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": { "enable": true, "scope": ["$RESOURCE/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": ["resources/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "embedBootstrapper" }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0QkQzQjM5REU4MUYyNzYKUldSMjhvSGVPVHU5WkZCQ1NNeURkeHpoN2h1SmtFYWpUcVN1blJlSlgrdmkrUmtBazZKdWRTemMK",
      "endpoints": ["https://github.com/jdixosnd/carnet-tcf/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
